# Copy to .env.production on the deployment host.
# Replace all REQUIRED values. Never commit the resulting file.

COMPOSE_PROJECT_NAME=nashrino
PRODUCTION_ENV_FILE=.env.production
APP_IMAGE_TAG=local

FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3100
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

APP_NAME=نشرینو
APP_ENV=production
APP_SECRET_KEY=REQUIRED_LONG_RANDOM_VALUE
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REQUIRED_STRONG_VALUE

FRONTEND_PUBLIC_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
META_OAUTH_REDIRECT_URI=https://api.example.com/instagram/oauth/callback

POSTGRES_DB=nashrino
POSTGRES_USER=nashrino
POSTGRES_PASSWORD=REQUIRED_DATABASE_VALUE
DATABASE_URL=postgresql+psycopg://nashrino:REQUIRED_DATABASE_VALUE@postgres:5432/nashrino

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=2

MEDIA_DIR=/app/storage/media
RUBIKA_API_BASE_URL=https://botapi.rubika.ir/v3

META_GRAPH_BASE_URL=https://graph.facebook.com
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
META_GRAPH_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_OAUTH_SCOPES=instagram_basic,instagram_content_publish,instagram_manage_comments,instagram_manage_messages,pages_show_list,pages_read_engagement
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=REQUIRED_LONG_RANDOM_VALUE
INSTAGRAM_WEBHOOK_APP_SECRET=
INSTAGRAM_AUTOMATION_DISPATCH_ENABLED=false
